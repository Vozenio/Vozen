---
const links = [
	{ label: 'Coverage', href: '#coverage' },
	{ label: 'Evidence', href: '#evidence' },
	{ label: 'Method', href: '#method' },
	{ label: 'Docs', href: '#' },
];
---

<header class="nav">
	<div class="wrap nav__inner">
		<a href="/" class="brand" aria-label="Vozen home">
			<span class="brand__dot"></span>
			<span class="brand__word">vozen</span>
		</a>

		<nav class="nav__links" aria-label="Primary">
			{links.map((l) => <a href={l.href}>{l.label}</a>)}
		</nav>

		<div class="nav__actions">
			<a href="#" class="nav__signin">Sign in</a>
			<a href="#start" class="btn btn--primary nav__cta">Request an audit</a>

			<details class="menu">
				<summary class="menu__btn" aria-label="Menu">
					<svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
						<path d="M2 4.5h14M2 9h14M2 13.5h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
					</svg>
				</summary>
				<nav class="menu__panel" aria-label="Primary, compact">
					{links.map((l) => <a href={l.href}>{l.label}</a>)}
					<a href="#" class="menu__signin">Sign in</a>
				</nav>
			</details>
		</div>
	</div>
</header>

<script>
	// Deepen the nav's edge once content scrolls beneath it
	const nav = document.querySelector('.nav');
	const onScroll = () => nav?.classList.toggle('nav--scrolled', window.scrollY > 8);
	window.addEventListener('scroll', onScroll, { passive: true });
	onScroll();

	// Close the compact menu after choosing a destination
	const menu = document.querySelector('.menu');
	menu?.querySelectorAll('a').forEach((a) =>
		a.addEventListener('click', () => menu.removeAttribute('open'))
	);
</script>

<style>
	.nav {
		position: sticky;
		top: 0;
		z-index: 50;
		background: color-mix(in srgb, var(--paper) 85%, transparent);
		backdrop-filter: saturate(1.4) blur(10px);
		border-bottom: 1px solid var(--line);
		transition: border-color 0.2s var(--ease), box-shadow 0.2s var(--ease);
	}

	.nav--scrolled {
		border-bottom-color: var(--line-strong);
		box-shadow: 0 1px 8px rgba(28, 27, 22, 0.05);
	}

	.nav__inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: 64px;
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 9px;
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 21px;
		letter-spacing: -0.01em;
	}

	.brand__dot {
		width: 10px;
		height: 10px;
		border-radius: 2px;
		background: var(--red);
		transform: rotate(45deg);
	}

	.nav__links {
		display: flex;
		gap: 30px;
		font-size: 14.5px;
		color: var(--ink-soft);
	}

	.nav__links a {
		position: relative;
		padding: 4px 0;
		transition: color 0.16s var(--ease);
	}

	.nav__links a::after {
		content: '';
		position: absolute;
		left: 0;
		bottom: 0;
		width: 100%;
		height: 1.5px;
		background: var(--red);
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 0.22s var(--ease);
	}

	.nav__links a:hover {
		color: var(--ink);
	}

	.nav__links a:hover::after {
		transform: scaleX(1);
	}

	.nav__actions {
		display: flex;
		align-items: center;
		gap: 18px;
	}

	.nav__signin {
		font-size: 14.5px;
		color: var(--ink-soft);
		transition: color 0.16s var(--ease);
	}

	.nav__signin:hover {
		color: var(--ink);
	}

	.nav__cta {
		padding: 9px 16px;
		font-size: 14px;
	}

	/* Compact menu: hidden until the inline links give way */
	.menu {
		display: none;
		position: relative;
	}

	.menu__btn {
		list-style: none;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 36px;
		height: 36px;
		border: 1px solid var(--line-strong);
		border-radius: var(--r-sm);
		color: var(--ink);
		cursor: pointer;
		background: var(--card);
	}

	.menu__btn::-webkit-details-marker {
		display: none;
	}

	.menu[open] .menu__btn {
		border-color: var(--ink);
	}

	.menu__panel {
		position: absolute;
		top: calc(100% + 10px);
		right: 0;
		min-width: 200px;
		display: flex;
		flex-direction: column;
		background: var(--card);
		border: 1px solid var(--line-strong);
		border-radius: var(--r);
		box-shadow: 0 16px 40px -20px rgba(28, 27, 22, 0.35);
		overflow: hidden;
	}

	.menu__panel a {
		padding: 12px 16px;
		font-size: 14.5px;
		color: var(--ink);
	}

	.menu__panel a + a {
		border-top: 1px solid var(--line);
	}

	.menu__panel a:hover {
		background: var(--paper-2);
	}

	.menu__signin {
		color: var(--ink-soft);
	}

	@media (max-width: 720px) {
		.nav__links,
		.nav__signin {
			display: none;
		}
		.menu {
			display: block;
		}
	}
</style>
