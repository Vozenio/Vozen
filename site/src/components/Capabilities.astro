---
const integrations = ['github', 'gitlab', 'bitbucket', 'vs-code', 'ci/cd'];

const ledger = [
	{ sev: 'CRIT', sevClass: 'is-crit', what: 'SQL injection · CWE-89', where: 'src/api/users.ts:41' },
	{ sev: 'HIGH', sevClass: 'is-high', what: 'Hardcoded AWS key', where: 'worker/deploy.ts:12' },
	{ sev: 'MED', sevClass: '', what: 'Vulnerable transitive dep', where: 'pnpm-lock.yaml' },
];

const cards = [
	{
		n: '02',
		title: 'Vulnerability detection',
		body: 'Injection, broken auth, SSRF, path traversal. Every finding mapped to OWASP and CWE, with evidence attached.',
	},
	{
		n: '03',
		title: 'Secrets & credentials',
		body: 'Leaked keys and tokens across code, config, and git history, ranked by real exposure.',
	},
	{
		n: '04',
		title: 'Supply chain',
		body: 'Dependency CVEs, malicious packages, and license risk, with an exportable SBOM.',
	},
	{
		n: '05',
		title: 'Fix PRs, not tickets',
		body: 'The auditor opens reviewed patches with tests. You approve the merge; nothing lands on its own.',
	},
	{
		n: '06',
		title: 'Reports & compliance',
		body: 'Sealed, evidence-backed audit reports your customers and SOC 2 / ISO auditors accept.',
	},
];
---

<section class="cap" id="coverage">
	<div class="wrap">
		<div class="cap__head reveal">
			<span class="eyebrow">§ 01 · Coverage</span>
			<h2 class="cap__title">Everything a security team would check, on every commit.</h2>
			<p class="cap__sub">
				Six audit surfaces, one AI engagement that never rotates off. Every finding
				is verified against your real code before it ever reaches you.
			</p>
		</div>

		<div class="bento">
			<article class="tile tile--hero reveal">
				<div class="tile__top">
					<span class="tile__n">01</span>
					<h3 class="tile__title">Autonomous code review</h3>
					<p class="tile__body">
						Agents map your architecture and data flows, then audit every change
						with the patience no human reviewer has. Candidate findings are
						re-verified before they reach the ledger, so what you see is real.
					</p>
				</div>

				<div class="ledger" aria-hidden="true">
					<div class="ledger__row ledger__row--head">
						<span>Sev</span><span>Finding</span><span>Location</span>
					</div>
					{
						ledger.map((r) => (
							<div class="ledger__row">
								<span class={`ledger__sev ${r.sevClass}`}>{r.sev}</span>
								<span class="ledger__what">{r.what}</span>
								<span class="ledger__where">{r.where}</span>
							</div>
						))
					}
				</div>

				<div class="tile__foot">
					<span class="tile__footlabel">Audits code from</span>
					<div class="chips">
						{integrations.map((m) => <span class="chip">{m}</span>)}
					</div>
				</div>
			</article>

			{
				cards.map((c, i) => (
					<article class="tile reveal" style={`transition-delay:${(i + 1) * 60}ms`}>
						<span class="tile__n">{c.n}</span>
						<h3 class="tile__title">{c.title}</h3>
						<p class="tile__body">{c.body}</p>
					</article>
				))
			}
		</div>
	</div>
</section>

<style>
	.cap {
		padding: 96px 0;
		border-top: 1px solid var(--line);
	}

	.cap__head {
		max-width: 42rem;
		margin-bottom: 48px;
	}

	.cap__title {
		font-size: clamp(28px, 4vw, 40px);
		margin: 16px 0 0;
	}

	.cap__sub {
		margin-top: 16px;
		font-size: 17px;
		color: var(--ink-soft);
	}

	.bento {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		grid-auto-rows: 1fr;
		gap: 16px;
	}

	.tile {
		background: var(--card);
		border: 1px solid var(--line);
		border-radius: var(--r);
		padding: 26px;
		display: flex;
		flex-direction: column;
		gap: 10px;
		transition: border-color 0.2s var(--ease), transform 0.2s var(--ease),
			box-shadow 0.2s var(--ease);
	}

	.tile:hover {
		border-color: var(--line-strong);
		transform: translateY(-3px);
		box-shadow: 0 12px 30px -18px rgba(28, 27, 22, 0.28);
	}

	.tile--hero {
		grid-column: span 2;
		grid-row: span 2;
		justify-content: space-between;
		padding: 34px;
	}

	.tile--hero .tile__title {
		font-size: 27px;
	}

	.tile--hero .tile__body {
		max-width: 32rem;
		font-size: 16px;
	}

	.tile__n {
		font-family: var(--font-mono);
		font-size: 12px;
		font-weight: 500;
		color: var(--red);
		letter-spacing: 0.06em;
	}

	.tile__title {
		font-size: 20px;
		margin: 2px 0 0;
	}

	.tile__body {
		font-size: 14.5px;
		color: var(--ink-soft);
		line-height: 1.55;
	}

	/* Findings ledger: a table row torn from the audit report */
	.ledger {
		border: 1px solid var(--line);
		border-radius: var(--r-sm);
		background: var(--paper-2);
		font-family: var(--font-mono);
		font-size: 12.5px;
		overflow: hidden;
	}

	.ledger__row {
		display: grid;
		grid-template-columns: 52px minmax(0, 1.3fr) minmax(0, 1fr);
		gap: 14px;
		align-items: baseline;
		padding: 9px 14px;
	}

	.ledger__row + .ledger__row {
		border-top: 1px solid var(--line);
	}

	.ledger__row--head {
		font-size: 10.5px;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--ink-faint);
		background: var(--card);
		border-bottom: 1px solid var(--line);
	}

	.ledger__sev {
		font-size: 11px;
		font-weight: 600;
		letter-spacing: 0.06em;
		color: var(--ink-faint);
	}

	.ledger__sev.is-crit { color: var(--red); }
	.ledger__sev.is-high { color: var(--ink); }

	.ledger__what {
		color: var(--ink);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.ledger__where {
		color: var(--ink-faint);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.tile__footlabel {
		display: block;
		font-family: var(--font-mono);
		font-size: 11px;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--ink-faint);
		margin-bottom: 11px;
	}

	.chips {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}

	.chip {
		font-family: var(--font-mono);
		font-size: 12.5px;
		color: var(--ink-soft);
		padding: 5px 10px;
		border: 1px solid var(--line);
		/* Document tags, not pills: the whole system stays on tight radii */
		border-radius: var(--r-sm);
		background: var(--paper-2);
	}

	.chip:first-child {
		color: var(--red-deep);
		border-color: var(--red-line);
		background: var(--red-tint);
	}

	@media (max-width: 860px) {
		.cap { padding: 68px 0; }
		/* Drop the equal-height rows once the 2×2 hero no longer applies,
		   otherwise every tile stretches to the tallest one's height */
		.bento { grid-template-columns: 1fr 1fr; grid-auto-rows: auto; }
		.tile--hero { grid-column: span 2; grid-row: auto; }
		.ledger__row { grid-template-columns: 44px minmax(0, 1fr); }
		.ledger__where { display: none; }
		.ledger__row--head span:last-child { display: none; }
	}

	@media (max-width: 560px) {
		.bento { grid-template-columns: 1fr; }
		.tile--hero { grid-column: span 1; }
	}
</style>
